{
    "name": "stougeiro/event",
    "description": "Lightweight event dispatcher with wildcard pattern matching and automatic deduplication. Dispatch string-based events, register invokable listeners, and load configurations from PHP files — all with zero cache overhead.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "event",
        "event-dispatcher",
        "dispatcher",
        "listener",
        "wildcard",
        "pubsub",
        "mediator",
        "observer",
        "lightweight",
        "deduplication",
        "framework-agnostic"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/event/issues",
        "source": "https://github.com/stougeiro/event"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "STDW\\Event\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "stougeiro/event-contract": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
